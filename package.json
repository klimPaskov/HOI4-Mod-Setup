{
  "name": "hoi4-mod-setup",
  "version": "0.6.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "Windows, macOS and Linux desktop wizard for preparing HOI4 mods for agentic development.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "node scripts/lint_frontend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "node scripts/run_rust_tests.mjs",
    "test:offline": "node scripts/run_offline_acceptance.mjs",
    "test:manifest": "node scripts/run_python.mjs -m unittest scripts/test_generate_manifest_evidence.py scripts/test_validate_repository.py scripts/test_linux_release_gates.py scripts/test_linux_secret_service.py",
    "test:release-assets": "node --test scripts/prepare_release_assets.node-test.mjs scripts/windows_installer_registry.node-test.mjs scripts/linux_packages.node-test.mjs scripts/mcp_package_integrity.node-test.mjs",
    "test:workflows": "node scripts/run_python.mjs scripts/check_workflow_security.py",
    "test:a11y": "node scripts/check_accessibility.mjs",
    "test:e2e": "node scripts/run_e2e_smoke.mjs",
    "test:released-e2e": "node scripts/run_released_e2e.mjs",
    "test:released-harness": "node --test scripts/released_e2e.node-test.mjs && node scripts/run_python.mjs -m unittest scripts/test_extract_mod_fixture.py",
    "docs:screenshots": "node scripts/run_e2e_smoke.mjs --update-documentation",
    "test:mcp-live": "node scripts/test_live_mcp.mjs",
    "test:scratch-live": "node scripts/run_scratch_install.mjs",
    "test:codex-live": "node scripts/test_live_codex.mjs",
    "test:claude-live": "cargo test -p hoi4-mod-setup --all-features --lib claude_code::tests::live_claude_code_route -- --ignored --nocapture",
    "test:e2e:install": "playwright install --with-deps chromium",
    "desktop:e2e": "node scripts/run_desktop_e2e.mjs",
    "installer:e2e": "node scripts/run_installer_e2e.mjs",
    "validate": "node scripts/run_python.mjs scripts/validate_repository.py",
    "validate:secrets": "node scripts/run_python.mjs scripts/check_committed_secrets.py",
    "release:build": "node scripts/release_build.mjs",
    "version:set": "node scripts/set_version.mjs",
    "release:rehash": "node scripts/refresh_release_manifest.mjs",
    "release:sbom": "node scripts/generate_sbom.mjs",
    "release:prepare": "node scripts/prepare_release_assets.mjs",
    "release:verify": "node scripts/release_verify.mjs",
    "release:notices": "node scripts/generate_third_party_notices.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
