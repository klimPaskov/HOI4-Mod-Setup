{
  "name": "hoi4-mod-setup",
  "version": "0.2.9",
  "private": true,
  "license": "Apache-2.0",
  "description": "Windows and macOS desktop wizard for preparing HOI4 mods for agentic development.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "node scripts/lint_frontend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:manifest": "python -m unittest scripts/test_generate_manifest_evidence.py",
    "test:release-assets": "node --test scripts/prepare_release_assets.node-test.mjs",
    "test:workflows": "python scripts/check_workflow_security.py",
    "test:a11y": "node scripts/check_accessibility.mjs",
    "test:e2e": "node scripts/run_e2e_smoke.mjs",
    "desktop:e2e": "node scripts/run_desktop_e2e.mjs",
    "installer:e2e": "node scripts/run_installer_e2e.mjs",
    "validate": "python scripts/validate_repository.py",
    "validate:secrets": "python scripts/check_committed_secrets.py",
    "release:build": "node scripts/release_build.mjs",
    "version:set": "node scripts/set_version.mjs",
    "release:rehash": "node scripts/refresh_release_manifest.mjs",
    "release:sbom": "node scripts/generate_sbom.mjs",
    "release:prepare": "node scripts/prepare_release_assets.mjs",
    "release:verify": "node scripts/release_verify.mjs",
    "release:notices": "node scripts/generate_third_party_notices.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
