{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klimpaskov.github.io/hoi4-mod-setup/schemas/installation-plan.schema.json",
  "title": "Installation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "source",
    "ai_provider",
    "ai_model",
    "ai_optimization_profile",
    "flatten_chat_sources",
    "codex_analysis",
    "selected_components",
    "wiki_required_pages",
    "download_ledger",
    "credential_references",
    "operations",
    "conflicts",
    "transaction",
    "approvals"
  ],
  "allOf": [
    {
      "if": { "properties": { "ai_provider": { "const": "codex" } } },
      "then": { "properties": { "ai_endpoint": { "type": ["null", "string"], "maxLength": 0 } } }
    },
    {
      "if": { "properties": { "ai_provider": { "enum": ["claude", "kimi", "glm", "deepseek", "local", "custom"] } } },
      "then": { "required": ["ai_endpoint"], "properties": { "ai_endpoint": { "type": "string", "minLength": 1 } } }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string"
    },
    "script_prefix": {
      "type": ["string", "null"],
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "primary_namespace": {
      "type": ["string", "null"],
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "ai_provider": {
      "enum": ["codex", "claude", "kimi", "glm", "deepseek", "local", "custom"]
    },
    "ai_model": {
      "type": "string",
      "minLength": 1
    },
    "ai_endpoint": {
      "type": ["string", "null"]
    },
    "ai_optimization_profile": {
      "type": "string",
      "minLength": 1
    },
    "flatten_chat_sources": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "maintenance_mode": {
      "enum": [
        "update",
        "repair",
        "reinstall",
        "remove",
        null
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "mode",
        "repository",
        "resolved_revision",
        "manifest_sha256",
        "manifest_origin"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "latest",
            "pinned_commit",
            "pinned_release"
          ]
        },
        "repository": {
          "type": "string"
        },
        "requested_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_origin": {
          "enum": [
            "remote",
            "bundled_revision_bootstrap"
          ]
        }
      }
    },
    "selected_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wiki_required_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "wiki_metadata": {
      "$ref": "#/$defs/wiki_metadata"
    },
    "credential_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provider", "reference"],
        "properties": {
          "name": { "const": "MESHY_API_KEY" },
          "provider": { "enum": ["windows_credential_manager", "macos_keychain"] },
          "reference": { "type": "string", "pattern": "^credential://meshy_api_key/(?:default|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$" }
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "destination",
          "content",
          "expected_sha256"
        ],
        "properties": {
          "component_id": { "type": "string" },
          "destination": { "type": "string" },
          "content": { "type": "string" },
          "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "external": { "type": "boolean" },
          "bytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
        }
      }
    },
    "download_ledger": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/download_ledger_entry"
      }
    },
    "optional_workflows": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "not_selected",
          "selected_pending",
          "ready",
          "incomplete",
          "planned_unavailable",
          "unsupported_platform"
        ]
      }
    },
    "portrait_pipeline": {
      "$ref": "#/$defs/portrait_pipeline"
    },
    "git_setup": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "mode",
        "branch",
        "initial_commit",
        "push_approved"
      ],
      "properties": {
        "mode": {
          "enum": [
            "initialize",
            "preserve",
            "skip"
          ]
        },
        "branch": {
          "type": "string"
        },
        "initial_commit": {
          "type": "boolean"
        },
        "remote_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "push_approved": {
          "const": false
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflictDecision"
      }
    },
    "external_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalAction"
      }
    },
    "transaction": {
      "type": "object",
      "required": [
        "stages",
        "backup_root",
        "staging_root",
        "project_root_mode",
        "project_root_parent",
        "project_root_leaf"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "prefixItems": [
            { "const": "preflight" },
            { "const": "repository source resolution" },
            { "const": "selective download" },
            { "const": "checksum verification" },
            { "const": "dry-run review" },
            { "const": "backup" },
            { "const": "staging" },
            { "const": "validation" },
            { "const": "apply" },
            { "const": "post-install checks" },
            { "const": "readiness report" },
            { "const": "rollback record" }
          ],
          "items": false
        },
        "backup_root": {
          "type": "string"
        },
        "staging_root": {
          "type": "string"
        },
        "directories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "atomic_apply_expected": {
          "type": "boolean"
        },
        "project_root_mode": {
          "enum": [
            "existing",
            "create_leaf"
          ]
        },
        "project_root_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_root_leaf": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approvals": {
      "type": "object",
      "required": [
        "dry_run_reviewed",
        "external_actions_reviewed",
        "git_remote_approved",
        "push_approved"
      ],
      "properties": {
        "dry_run_reviewed": {
          "type": "boolean"
        },
        "external_actions_reviewed": {
          "type": "boolean"
        },
        "git_remote_approved": {
          "type": "boolean"
        },
        "push_approved": {
          "type": "boolean"
        }
      }
    },
    "codex_analysis": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "engine",
        "auth_mode",
        "analysis_id",
        "schema_version",
        "input_sha256",
        "output_sha256",
        "confirmed_fields",
        "confirmed_at",
        "source_revision",
        "source_manifest_sha256"
      ],
      "properties": {
        "engine": {
          "enum": ["codex_app_server", "provider_api"]
        },
        "auth_mode": {
          "enum": ["chatgpt", "api_key", "local_endpoint"]
        },
        "provider": {
          "enum": ["codex", "claude", "kimi", "glm", "deepseek", "local", "custom"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "optimization_profile": {
          "type": ["string", "null"]
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmed_fields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "account_identity_persisted": {
          "const": false
        },
        "analysis_purpose": {
          "enum": [
            "existing_project_import",
            "maintenance_reanalysis",
            null
          ]
        },
        "evidence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "portrait_pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provider",
        "provider_status",
        "workflow_repository",
        "workflow_branch",
        "workflow_commit",
        "preferred_workflow",
        "local_comfyui_root",
        "local_server_url",
        "runpod_url",
        "runpod_workspace",
        "mcp_registered"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["cloud", "local", "runpod", "disabled"] },
        "provider_status": { "type": "string", "minLength": 1 },
        "workflow_repository": { "type": "string", "format": "uri" },
        "workflow_branch": { "type": "string", "minLength": 1 },
        "workflow_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "preferred_workflow": { "enum": ["source", "processing_only"] },
        "local_comfyui_root": { "type": "string" },
        "local_server_url": { "type": "string" },
        "runpod_url": { "type": "string" },
        "runpod_workspace": { "type": "string" },
        "mcp_registered": { "type": "boolean" }
      }
    },
    "download_ledger_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_path",
        "destination",
        "source_revision",
        "manifest_sha256",
        "sha256",
        "size",
        "component_id",
        "ownership",
        "platform",
        "executable"
      ],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "component_id": { "type": "string", "minLength": 1 },
        "ownership": { "enum": ["managed", "merged", "generated", "external"] },
        "platform": { "enum": ["windows", "macos", "all"] },
        "executable": { "type": "boolean" }
      }
    },
    "wiki_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_media_policy",
        "source_status",
        "license_status"
      ],
      "properties": {
        "snapshot_marker": {
          "type": ["string", "null"]
        },
        "required_media_policy": {
          "enum": ["all_declared", "referenced_only", "none"]
        },
        "source_status": {
          "type": "string",
          "minLength": 1
        },
        "license_status": {
          "type": "string",
          "minLength": 1
        },
        "repository_license_status": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component_id",
        "ownership",
        "action",
        "location_scope",
        "destination",
        "source_sha256",
        "source_path",
        "source_size",
        "platform",
        "executable",
        "result_sha256",
        "base_sha256",
        "local_sha256",
        "local_state",
        "resolution",
        "external",
        "rollback"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component_id": {
          "type": "string"
        },
        "ownership": {
          "enum": [
            "managed",
            "merged",
            "generated",
            "external"
          ]
        },
        "action": {
          "enum": [
            "create",
            "replace",
            "merge",
            "rename",
            "skip",
            "delete_managed",
            "generate",
            "chmod",
            "external"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "type": "string"
        },
        "external": {
          "type": "boolean"
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "platform": {
          "enum": [
            "windows",
            "macos",
            "all",
            null
          ]
        },
        "executable": {
          "type": "boolean"
        },
        "result_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "base_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "local_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "local_state": {
          "enum": [
            "absent",
            "unmodified",
            "modified",
            "unknown"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollback": {
          "enum": [
            "remove_created",
            "restore_backup",
            "reverse_merge",
            "none"
          ]
        },
        "location_scope": {
          "enum": [
            "project",
            "external_launcher",
            "application_data"
          ]
        }
      }
    },
    "conflictDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "options",
        "selected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "enum": [
              "keep",
              "replace",
              "merge",
              "rename",
              "skip"
            ]
          }
        },
        "selected": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "keep",
            "replace",
            "merge",
            "rename",
            "skip",
            null
          ]
        },
        "apply_to_identical": {
          "type": "boolean"
        }
      }
    },
    "externalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component_id",
        "platform",
        "command_source",
        "executable",
        "arguments",
        "working_directory",
        "environment_names",
        "network_access",
        "expected_writes",
        "privilege",
        "rollback_boundary",
        "risk",
        "requires_approval"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component_id": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "windows",
            "macos"
          ]
        },
        "command_source": {
          "enum": [
            "remote_manifest",
            "repository_script",
            "generated_adapter"
          ]
        },
        "executable": {
          "type": ["string", "null"]
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "working_directory": {
          "type": ["string", "null"]
        },
        "environment_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network_access": {
          "type": "string"
        },
        "expected_writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "privilege": {
          "type": "string"
        },
        "rollback_boundary": {
          "type": "string"
        },
        "display_command": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "requires_approval": {
          "type": "boolean"
        },
        "contains_secret": {
          "const": false
        },
        "verified_executable_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_executable_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verified_interpreter_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_interpreter_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verified_runtime_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_runtime_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verified_package_name": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "verified_package_version": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "verified_package_integrity": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "verified_package_tree_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_package_file_count": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 10000
        },
        "verified_runtime_entry": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "required_tool_names": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  }
}
