{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klimpaskov.github.io/hoi4-mod-setup/schemas/readiness-report.schema.json",
  "title": "Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "project_id",
    "generated_at",
    "codex",
    "checks",
    "summary",
    "core_ready",
    "open_in_codex"
  ],
  "if": {
    "required": ["codex"],
    "properties": {
      "codex": {
        "required": ["provider"],
        "properties": { "provider": { "const": "none" } }
      }
    }
  },
  "then": {
    "properties": {
      "codex": {
        "properties": {
          "integration": { "const": "none" },
          "auth_mode": { "const": "none" },
          "authenticated_during_setup": { "const": false },
          "analysis_status": { "const": "not_run" }
        }
      }
    }
  },
  "else": {
    "properties": {
      "codex": {
        "properties": {
          "integration": { "not": { "const": "none" } },
          "auth_mode": { "not": { "const": "none" } },
          "analysis_status": { "not": { "const": "not_run" } }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "pass",
        "warn",
        "block",
        "not_selected",
        "planned_unavailable"
      ],
      "properties": {
        "pass": {
          "type": "integer"
        },
        "warn": {
          "type": "integer"
        },
        "block": {
          "type": "integer"
        },
        "not_selected": {
          "type": "integer"
        },
        "planned_unavailable": {
          "type": "integer"
        }
      }
    },
    "core_ready": {
      "type": "boolean"
    },
    "open_in_codex": {
      "type": "object",
      "required": [
        "enabled",
        "blocking_check_ids"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "blocking_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command_preview": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "integration",
        "auth_mode",
        "authenticated_during_setup",
        "analysis_status",
        "confirmed_field_count",
        "no_account_metadata_persisted",
        "blocking_check_ids"
      ],
      "properties": {
        "provider": {
          "enum": ["none","codex","claude_account","claude","kimi","glm","deepseek","local","custom","gemini_account","grok_account","gemini","grok"]
        },
        "model": {
          "type": "string"
        },
        "integration": {
          "enum": ["codex_app_server","claude_code_cli","provider_api","provider_cli","none"]
        },
        "auth_mode": {
          "enum": ["chatgpt","claude_account","api_key","local_endpoint","provider_account","none"]
        },
        "authenticated_during_setup": {
          "type": "boolean"
        },
        "analysis_status": {
          "enum": [
            "confirmed",
            "block",
            "not_run"
          ]
        },
        "confirmed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "no_account_metadata_persisted": {
          "const": true
        },
        "blocking_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "label",
        "status",
        "blocking",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "descriptor",
            "launcher",
            "thumbnail",
            "structure",
            "codex",
            "ai",
            "skill",
            "subagent",
            "mcp",
            "wiki",
            "git",
            "environment",
            "hash",
            "conflict",
            "dependency",
            "workflow",
            "analysis"
          ]
        },
        "label": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "block",
            "not_selected",
            "planned_unavailable",
            "unsupported_platform"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "value": {},
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
