{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klimpaskov.github.io/hoi4-mod-setup/schemas/project-state.schema.json",
  "title": "Project Setup State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_root",
    "platform",
    "wizard",
    "preferences",
    "codex",
    "ai",
    "coding_environments",
    "credential_references"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "platform": {
      "enum": [
        "windows",
        "macos"
      ]
    },
    "wizard": {
      "type": "object",
      "required": [
        "current_step",
        "completed_steps"
      ],
      "properties": {
        "current_step": {
          "type": "string"
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "draft_values": {
          "type": "object"
        }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "source_mode": {
          "enum": [
            "latest",
            "pinned_commit",
            "pinned_release"
          ]
        },
        "telemetry": {
          "const": false
        }
      }
    },
    "credential_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "provider",
          "reference"
        ],
        "properties": {
          "name": {
            "const": "MESHY_API_KEY"
          },
          "provider": {
            "enum": [
              "windows_credential_manager",
              "macos_keychain"
            ]
          },
          "reference": {
            "type": "string",
            "pattern": "^credential://meshy_api_key/(?:default|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
          },
          "secret_value": {
            "not": {}
          }
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration",
        "auth_mode",
        "auth_status",
        "analysis_required",
        "analysis_status",
        "account_values_persisted"
      ],
      "properties": {
        "integration": {
          "enum": [
            "codex_app_server",
            "provider_api"
          ]
        },
        "auth_mode": {
          "enum": [
            "chatgpt",
            "api_key",
            "local_endpoint"
          ]
        },
        "auth_status": {
          "enum": [
            "signed_out",
            "signing_in",
            "signed_in",
            "configured",
            "failed",
            "usage_limited"
          ]
        },
        "analysis_required": {
          "const": true
        },
        "analysis_status": {
          "enum": [
            "pending",
            "running",
            "review",
            "confirmed",
            "blocked"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_values_persisted": {
          "const": false
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning_effort", "optimization_profile"],
      "properties": {
        "provider": {
          "enum": ["codex", "claude", "kimi", "glm", "deepseek", "local", "custom"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "xhigh", "max"]
        },
        "optimization_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coding_environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "additional"],
      "properties": {
        "primary": {
          "enum": ["codex", "claude_code", "cursor", "qoder", "opencode"]
        },
        "additional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["codex", "claude_code", "cursor", "qoder", "opencode"]
          }
        }
      }
    },
    "portrait_pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provider",
        "provider_status",
        "workflow_repository",
        "workflow_branch",
        "workflow_commit",
        "preferred_workflow",
        "local_comfyui_root",
        "local_server_url",
        "runpod_url",
        "runpod_workspace",
        "mcp_registered"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["cloud", "local", "runpod", "disabled"] },
        "provider_status": { "type": "string", "minLength": 1 },
        "workflow_repository": { "type": "string", "format": "uri" },
        "workflow_branch": { "type": "string", "minLength": 1 },
        "workflow_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "preferred_workflow": { "enum": ["source", "processing_only"] },
        "local_comfyui_root": { "type": "string" },
        "local_server_url": { "type": "string" },
        "runpod_url": { "type": "string" },
        "runpod_workspace": { "type": "string" },
        "mcp_registered": { "type": "boolean" }
      }
    }
  }
}
