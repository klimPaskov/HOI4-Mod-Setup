{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HOI4 Mod Setup",
  "version": "0.3.4",
  "identifier": "com.klimpaskov.hoi4-mod-setup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "HOI4 Mod Setup",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "dmg"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IEYyODcxNTA4MjNDQjlCREUKUldUZW04c2pDQldIOGpmQjNXTURSRFVKSm5ZaTZkbU4zbzdBK3pHYmRHaDhsUFk1b3R3ZERwRVUK",
      "endpoints": [
        "https://github.com/klimPaskov/HOI4-Mod-Setup/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
